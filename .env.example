# =============================================================================
# Peel Car Sales 2.0 — environment variable contract
# Copy to .env.local and fill in. src/lib/env.ts will fail the build if any
# REQUIRED var is missing. Optional vars unlock features when present.
# =============================================================================

# --- Public site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_ENV="development"   # development | preview | production

# --- Supabase (REQUIRED to ship Phase 1+) ------------------------------------
# Create at https://supabase.com — saadzafar.20@gmail.com is the project owner
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""         # server only, never exposed to client
SUPABASE_PROJECT_ID=""               # for `pnpm supabase:types`

# --- Anthropic (Phase 6 AI concierge) ----------------------------------------
ANTHROPIC_API_KEY=""

# --- Algolia (Phase 1 search) ------------------------------------------------
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""    # search-only key, safe to expose
ALGOLIA_ADMIN_KEY=""                 # server only

# --- fal.ai (Phase 2 photo pipeline) -----------------------------------------
FAL_KEY=""
FAL_WEBHOOK_SECRET=""                # for verifying inbound webhook signatures

# --- Twilio Conversations (Phase 6) ------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_CONVERSATIONS_SERVICE_SID=""
TWILIO_WHATSAPP_FROM=""              # e.g. whatsapp:+19056780048

# --- Stripe (Phase 1 hold deposits) ------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=""

# --- Klaviyo (marketing) -----------------------------------------------------
KLAVIYO_PRIVATE_API_KEY=""
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=""

# --- Plaid (Phase 5 income/assets) -------------------------------------------
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"                  # sandbox | development | production

# --- Carfax / TrueTrade (Phase 3 widget origin allowlist) --------------------
NEXT_PUBLIC_CARFAX_TRUETRADE_ORIGIN="https://truetrade.carfax.ca"

# --- AutoVerify (Phase 3 widget origin allowlist) ----------------------------
NEXT_PUBLIC_AUTOVERIFY_ORIGIN="https://sdk.autoverify.com"
NEXT_PUBLIC_AUTOVERIFY_HOME_WIDGET_ID="dbc97bad-4ea9-49bb-bd03-94fc2e2fb0f2"
NEXT_PUBLIC_AUTOVERIFY_VDP_WIDGET_ID="2166f6a8-31a9-4e1e-869f-fb70ed326194"

# --- AutoRaptor (Phase 3 lead bridge) ----------------------------------------
# ADF/XML email forwarding — value provided by Peel Car Sales
AUTORAPTOR_LEAD_EMAIL=""
# Chatbot account ID — exposed to client to load the embed script
NEXT_PUBLIC_AUTORAPTOR_ACCOUNT_ID=""

# --- Carfax TrueTrade dealer account -----------------------------------------
# Comes from the Carfax TrueTrade dealer dashboard
NEXT_PUBLIC_CARFAX_TRUETRADE_ACCOUNT=""

# --- pgsodium / app-level secrets (Phase 5) ----------------------------------
APP_SIN_HMAC_SECRET=""               # 64-hex-char random string for SIN tokens

# --- Sentry / PostHog (Phase 9) ----------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Tracking pixels (port from current site) --------------------------------
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_FB_PIXEL_ID_PRIMARY="1830560367418171"
NEXT_PUBLIC_FB_PIXEL_ID_SECONDARY="1844547692630783"
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
